# ==========================================
# BASE DE DONNÉES
# ==========================================
# Si déployé sur Render ou Supabase, définis DATABASE_URL
# DATABASE_URL=postgresql://user:password@host:5432/dbname

DB_HOST=localhost
DB_PORT=5432
DB_NAME=scraper_legende
DB_USER=postgres
DB_PASSWORD=change_moi

# ==========================================
# PARAMÈTRES DE SCRAPING ÉTHIQUE
# ==========================================
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; ScraperLegendeBot/2.0; +https://github.com/votre-compte/scraper-legende)
SCRAPER_DELAY_SECONDS=2
SCRAPER_TIMEOUT=15

# ==========================================
# CLÉS D'API OFFICIELLES (PHASE 2)
# ==========================================
# Stack Exchange API Key (Optionnel - augmente le quota de 300 à 10 000 req/jour)
STACKEXCHANGE_KEY=

# Product Hunt Developer Token (Optionnel - fallback sur flux public officiel si non renseigné)
PRODUCTHUNT_DEV_TOKEN=

# GitHub Personal Access Token (Optionnel - augmente la limite de 60 à 5000 requêtes/heure)
GITHUB_TOKEN=

# Reddit API Credentials (EN ATTENTE D'APPROBATION — Responsible Builder Policy 2026)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ScraperLegende/2.0 (by /u/votre_username)
